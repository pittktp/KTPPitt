{
  "name": "ktppitt",
  "version": "1.0.0",
  "description": "Official website for Kappa Theta Pi at the University of Pittsburgh.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pittktp/KTPPitt.git"
  },
  "license": "ISC",
