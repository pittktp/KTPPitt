    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "html-validate": "^10.9.0",
    "nodemon": "^3.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
